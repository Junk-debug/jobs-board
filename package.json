{
  "name": "coople-jobs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check --error-on-warnings",
    "format": "biome check --write",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intersection-observer": "^11.0.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.5",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.22.0"
  }
}
