{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!docs",
      "!src/test/fixtures",
      "!src/components/ui",
      "!public",
      "!**/*.md"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error",
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "Network calls go through src/api/client.ts."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*-skeleton.tsx"],
      "linter": {
        "rules": { "suspicious": { "noArrayIndexKey": "off" } }
      }
    },
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/api/**", "@/routes/**"],
                    "message": "Components render what they get. Data comes through hooks, pages compose."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/routes/**",
        "src/queries/**",
        "src/stores/**",
        "src/hooks/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/api/client": "Use the endpoint functions in src/api/<entity>/, for example src/api/jobs/jobs.api.ts."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/api/client.ts",
        "src/test/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": { "style": { "noRestrictedGlobals": "off" } }
      }
    }
  ]
}
